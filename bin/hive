#!/usr/bin/env fish
# Adapted from MrP01's "hivemind" script
set NAME benedikt
if contains -- --help $argv; or contains -- -h $argv
    echo "Usage: hive [flags] [subcommand | [--] container-command...]

Subcommands:
  list                    list running agent containers
  stop                    stop all running agent containers
  reconnect               re-establish this container's networking (wifi/VPN)
  build                  build the docker image (default: benedikt-agent)

Container commands:
  hive                run claude in the container (default)
  hive <cmd...>       run <cmd...> in the container
  hive --shell -- <c> run <c> via 'bash -lc' in the container
  hive -- <cmd...>    run <cmd...>, even if <cmd> collides with a
                          subcommand name (e.g. '-- stop')

Flags:
  --root                  run the container as root and --privileged
  --shell                 run the container command through 'bash -lc'
  --image <name>          override the docker image (default: benedikt-agent)
  -h, --help              show this help"
    exit 0
end
set AGENT_DIR $HOME/agents
set UID (id -u)
set GID (id -g)
set UNAME (id -u -n)
# --root flag: run the container as root and with --privileged
set ROOT_MODE 0
if contains -- --root $argv
    set ROOT_MODE 1
    set argv (string match -v -- --root $argv)
end

# --shell flag: run the container command through `bash -lc` instead of exec'ing
# it directly, e.g. `hive --shell -- 'cd sub && npm test'`
set SHELL_MODE 1
if contains -- --shell $argv
    set SHELL_MODE 1
    set argv (string match -v -- --shell $argv)
end

# Create a .claude, .pi dir + .history, and .bash_history file in the agent directory if they don't exist
if not test -f "$AGENT_DIR/.claude"
    mkdir -p "$AGENT_DIR"
    mkdir -p "$AGENT_DIR/.claude"
end
if not test -f "$AGENT_DIR/.pi"
    mkdir -p "$AGENT_DIR/.pi"
end
if not test -f "$AGENT_DIR/.hermes"
    mkdir -p "$AGENT_DIR/.hermes"
end
if not test -f "$AGENT_DIR/.history"
    touch "$AGENT_DIR/.history"
end
if not test -f "$AGENT_DIR/.bash_history"
    touch "$AGENT_DIR/.bash_history"
end

# --image flag: override the docker image to use


set IMAGE $NAME-agent
# for i in (seq (count $argv))
#     if test "$argv[$i]" = --image
#         set IMAGE $argv[(math $i + 1)]
#         set argv[$i] ''
#         set argv[(math $i + 1)] ''
#         set argv (string match -v -- '' $argv)
#         break
#     end
# end

# Create a deterministic container name from the current working directory
set PROJECT_HASH (string replace -ra '[^a-zA-Z0-9]' '-' (pwd))
set CONTAINER_NAME "$NAME-agent$PROJECT_HASH"

# Separate subcommands from a container command.
#   hive stop            → subcommand: stop all running agent containers
#   hive reconnect       → subcommand: re-establish this container's networking
#   hive                 → default: run claude in the container
#   hive <cmd...>        → run <cmd...> in the container
#   hive --shell -- <c>  → run <c> via `bash -lc` in the container
#   hive -- <cmd...>     → run <cmd...> in the container, even if <cmd>
#                              collides with a subcommand name (e.g. `-- stop`)
if set -l sep (contains -i -- -- $argv)
    # Everything after `--` is a container command, no subcommand dispatch.
    set CONTAINER_CMD $argv[(math $sep + 1)..-1]
else
    # No separator: first word may be a subcommand.
    switch "$argv[1]"
        case list
            docker ps --filter "name=$NAME-agent*" \
                --format 'table {{.Names}}\t{{.Status}}'
            exit $status
        case stop
            docker ps --filter "name=$NAME-agent*" --filter status=running -aq \
                | xargs --no-run-if-empty docker stop
            exit $status
        case reconnect
            # Restart networking/DNS after a host network change (wifi/VPN).
            docker network disconnect bridge $CONTAINER_NAME
            docker network connect bridge $CONTAINER_NAME
            exit $status
        case rm
            # Remove all stopped agent containers
            docker ps --filter "name=benedikt-agent*" -aq \
                | xargs --no-run-if-empty docker rm --force
            exit $status
        case build
            # build the docker image (default: benedikt-agent), from Dockerfile.base
            echo "Building docker image $IMAGE with UID=$UID and GID=$GID and UNAME=$UNAME"
            docker build  --build-arg UID=$UID --build-arg GID=$GID --build-arg UNAME=$UNAME -t $IMAGE -f ~/agents/Dockerfile.base ~/agents
            exit $status
    end
    set CONTAINER_CMD $argv
end

# Command to run inside the container
if test $SHELL_MODE -eq 1
    set HIVE_COMMAND bash -lc "$CONTAINER_CMD"
else if set -q CONTAINER_CMD[1]
    set HIVE_COMMAND $CONTAINER_CMD
else
    set HIVE_COMMAND bash -lc "$HOME/.local/bin/claude"
end
# if claude.json does not exist, touch and create it with default content
if not test -f "$AGENT_DIR/.claude.json"
    echo '{}' > "$AGENT_DIR/.claude.json"
end
# Common docker args
set DOCKER_ARGS \
    -it \
    --user $UID:$GID \
    --name $CONTAINER_NAME \
    -v $AGENT_DIR/.claude:/home/$UNAME/.claude \
    -v $AGENT_DIR/.pi:/home/$UNAME/.pi \
    -v $AGENT_DIR/.claude.json:/home/$UNAME/.claude.json \
    -v $AGENT_DIR/.history:/home/$UNAME/.history \
    -v $AGENT_DIR/.bash_history:/home/$UNAME/.bash_history \
    -v $AGENT_DIR/.hermes:/home/$UNAME/.hermes \
    # -v $AGENT_DIR/.bashrc:/home/$UNAME/.bashrc \
    -e UV_PROJECT_ENVIRONMENT='.uv-agent' \
    --tmpfs /tmp \
    --cap-drop=ALL \
    -v (pwd):(pwd) \
    -w (pwd)

# add GPU support if nvidia-smi is available
if command -v nvidia-smi >/dev/null 2>&1
    set DOCKER_ARGS $DOCKER_ARGS --gpus all
end

set EXEC_ARGS -it
if test $ROOT_MODE -eq 1
    set EXEC_ARGS $EXEC_ARGS --user root --privileged
end

# Does the container already exist?
if docker container inspect $CONTAINER_NAME >/dev/null 2>&1
    # Is it running?
    set RUNNING (docker inspect -f '{{.State.Running}}' $CONTAINER_NAME)

    if test "$RUNNING" = "true"
        echo "Re-attaching to running container: $CONTAINER_NAME"
        exec docker exec $EXEC_ARGS $CONTAINER_NAME $HIVE_COMMAND
    else
        echo "Starting existing container: $CONTAINER_NAME"
        docker start $CONTAINER_NAME
        exec docker exec $EXEC_ARGS $CONTAINER_NAME $HIVE_COMMAND
    end
else
    echo "Creating new container: $CONTAINER_NAME"
    if test $ROOT_MODE -eq 1
        set DOCKER_ARGS $DOCKER_ARGS --user root --privileged
    end
    exec docker run \
        $DOCKER_ARGS \
        $IMAGE \
        $HIVE_COMMAND
end
